{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "types": [
            "vite/client"
        ],
        "paths": {
            "@/*": [
                "./resources/js/*"
            ],
            "next/link": [
                "./resources/js/compat/next-link.tsx"
            ],
            "next/navigation": [
                "./resources/js/compat/next-navigation.ts"
            ]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx"
    ]
}
